# URL o nombre DNS del servidor Proxmox VE.
PROXMOX_HOST=https://pve.example.com:8006
# Usuario con permisos de solo lectura, por ejemplo monitor@pam.
PROXMOX_USER=monitor@pam
# TOKEN_ID=SECRET, usuario@realm!TOKEN_ID=SECRET o header completo.
PROXMOX_TOKEN=monitor-token=REEMPLAZA_CON_EL_SECRETO
# Solo necesario con --ai o --chat.
GOOGLE_API_KEY=REEMPLAZA_CON_TU_API_KEY
# Modelo disponible en tu cuenta; se usa si no se especifica otro.
GEMINI_MODEL=gemini-2.0-flash
